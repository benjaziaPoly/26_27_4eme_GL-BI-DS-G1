{% extends 'template_job.html.twig' %}
{% block title %}
    {{ parent() }} - Liste des Job
{% endblock %}

{% block body %}
    <h3>Liste des Offres </h3>
    <table class="table table-bordred">
        <thead>
            <tr>
                <td>Type</td>
                <td>Compagnie</td>
                <td>Email</td>
                <td>Description</td>
                <td>Date Expiration</td>
            </tr>
        </thead>
        <tbody>
            {% for job in jobs %}
                <tr>
                <td>{{ job.type }}</td>
                <td>{{ job.company }}</td>
                <td>{{ job.email }}</td>
                <td>{{ job.description }}</td>
                <td>{{ job.expiresAt | date("d-m-Y")}}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>   
{% endblock %}